{
  "name": "webdevicecable",
  "private": true,
  "version": "0.1.2",
  "scripts": {
    "build:sdk": "tsc -p sdk/tsconfig.json",
    "check:sdk": "tsc -p sdk/tsconfig.json --noEmit",
    "test:sdk": "node --test sdk/client.test.mjs sdk/storage.test.mjs sdk/relay.test.mjs",
    "test:e2e": "node scripts/e2e.mjs && node scripts/commands-e2e.mjs && node scripts/launch-e2e.mjs",
    "theme:generate": "node scripts/generate-theme.mjs",
    "theme:check": "node scripts/generate-theme.mjs --check",
    "package:sdk": "npm run build:sdk && node scripts/sdk-package.mjs",
    "test:package": "node --experimental-vm-modules scripts/sdk-package-test.mjs",
    "check:sdk-drift": "node scripts/sdk-drift.mjs",
    "package:relay": "npm run package:sdk",
    "test:relay:contracts": "npm ci --ignore-scripts --prefix tests/relay-contract && go test -count=1 -run TestProviderSDKContracts ./internal/relay",
    "test:relay:docker": "node scripts/relay-e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
