FROM golang:1.27.3-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /wdc-relay ./cmd/wdc-relay
FROM alpine:3.22
RUN apk add --no-cache ca-certificates && addgroup -S -g 10001 wdc && adduser -S -u 10001 -G wdc wdc && mkdir /data && chown wdc:wdc /data
COPY --from=build /wdc-relay /usr/local/bin/wdc-relay
USER 10001:10001
VOLUME /data
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/readyz || exit 1
ENTRYPOINT ["wdc-relay"]
